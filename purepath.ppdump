  "SERVICE_METHOD-0A870232433DFAB8": "select cn1_0.id,cn1_0.configuration_identifier,cn1_0.configuration_tenant_id,cn1_0.description,cn1_0.is_secure,cn1_0.key,cn1_0.valid_from,cn1_0.valid_till,cn1_0.value from fp_configurationnode cn1_0 join fp_configuration c1_0 on c1_0.identifier=cn1_0.configuration_identifier and c1_0.tenant_id=cn1_0.configuration_tenant_id where cn1_0.valid_till>? and cn1_0.valid_from<=? and (c1_0.identifier,c1_0.tenant_id) in ((?,?)) and lower(cn1_0.key) like ? order by c1_0.name,cn1_0.key,cn1_0.valid_from desc",
